<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         backupGlobals="false"
         beStrictAboutTestsThatDoNotTestAnything="false"
         processIsolation="false"
         stopOnError="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="Browser">
            <directory suffix="Test.php">tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="local"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_URL" value="http://127.0.0.1:8099"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="file"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="database/dusk.sqlite"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="file"/>
        <env name="SESSION_DOMAIN" value="null"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="127.0.0.1:8099"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="CSCAPI_KEY" value="test-csc-key"/>
        <env name="CSCAPI_BASE_URL" value="https://api.countrystatecity.in/v1"/>
    </php>
</phpunit>
